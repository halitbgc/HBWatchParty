{
  "manifest_version": 3,
  "name": "HB Watch Party",
  "version": "1.0",
  "description": "YouTube Watch Party ve Sohbet Eklentisi",
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["*://*.youtube.com/*", "https://hbwatch.arztakvim.com.tr/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Watch Party Paneli",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["signalr.min.js", "auth.js", "content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}